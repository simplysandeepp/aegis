# ---------------------------------------------------------------------------
# Aegis — LLM Guardrail Gateway. Copy to `.env.local` and fill in.
# Both providers are used on their FREE tiers. No paid service is required.
# ---------------------------------------------------------------------------

# Groq free tier: https://console.groq.com/keys
# Free-tier limits are per-model and are typically on the order of
# 30 requests/min and 14,400 requests/day, with a separate tokens/min cap.
# Aegis serialises provider calls through a shared limiter (default
# concurrency 2) and backs off on 429/503, but you can still exhaust the
# daily quota with a large harness matrix. Use --limit and the result cache.
GROQ_API_KEY=

# Google AI Studio free tier: https://aistudio.google.com/apikey
# Gemini free tier is typically ~15 RPM / 1500 RPD on Flash-class models.
GOOGLE_GENERATIVE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Store raw prompt/response text in the decision log instead of only hashes.
# OFF by default so the log is safe to share. Turn on for local research only.
AEGIS_LOG_RAW=0

# Hard ceiling on tokens a single harness run may consume before it aborts.
AEGIS_TOKEN_BUDGET=200000

# Max concurrent provider requests across the whole process.
AEGIS_CONCURRENCY=2

# SQLite location.
AEGIS_DB_PATH=.data/aegis.db
